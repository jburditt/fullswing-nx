{
  "name": "fullswing-workspace",
  "version": "1.0.0",
  "description": "Nx/npm workspace root for the fullswing-blog and fullswing-cms projects",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "libs/*"
  ],
  "scripts": {
    "clean": "node -e \"const fs=require(\\\"node:fs\\\");fs.rmSync(\\\".build-infra\\\",{recursive:true,force:true});\"",
    "compile": "tsc -p tsconfig.json",
    "test": "npm run clean && npm run compile && node --test .build-infra/**/*.test.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "engines": {
    "node": ">=20.19.0"
  },
  "devDependencies": {
    "@types/node": "20.17.19",
    "typescript": "5.9.3",
    "nx": "23.2.1"
  },
  "nx": {}
}