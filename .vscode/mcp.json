{
  "servers": {
    "fullswing-blog-local": {
      "type": "http",
      "url": "https://localhost:3000/mcp"
    },
    "mcp-image": {
      "command": "npx",
      "args": ["-y", "mcp-image"],
      "env": {
        "GEMINI_API_KEY": "${input:gemini-api-key}",
        "IMAGE_OUTPUT_DIR": "/specs/imgs"
      }
    }
  }
}