{
  "$schema": "./node_modules/nx/schemas/nx-schema.json",
  "targetDefaults": {
    "compile": {
      "outputs": [
        "{projectRoot}/.build"
      ],
      "cache": true,
      "dependsOn": [
        "^compile"
      ]
    },
    "build": {
      "outputs": [
        "{projectRoot}/.build",
        "{projectRoot}/dist"
      ],
      "cache": true,
      "dependsOn": [
        "^compile"
      ]
    },
    "build:once": {
      "outputs": [
        "{projectRoot}/.build",
        "{projectRoot}/dist"
      ],
      "cache": true,
      "dependsOn": [
        "^compile"
      ]
    },
    "verify": {
      "outputs": [
        "{projectRoot}/.build",
        "{projectRoot}/dist"
      ],
      "cache": true,
      "dependsOn": [
        "^compile"
      ]
    },
    "test": {
      "cache": false,
      "dependsOn": [
        "^compile"
      ]
    },
    "clean": {
      "cache": false
    }
  },
  "analytics": false
}
